// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/arch.txt",
    "color": {
      "1": "cyan",
      "2": "cyan"
    },
    "padding": {
      "top": 0,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "cyan"
    },
    "percent": {
      "type": ["num"]
    }
  },

  "modules": [
    { "type": "custom",   "key": "╭─ SYSTEM ─────────────────────────────────────────────────╮", "keyColor": "cyan" },
    { "type": "title",    "key": "usr", "keyColor": "cyan"                                                          },
    { "type": "os",       "key": "os ", "keyColor": "cyan", "format": "{pretty-name}"                               },
    { "type": "host",     "key": "sys", "keyColor": "cyan", "format": "{family}"                                    },
    { "type": "cpu",      "key": "cpu", "keyColor": "cyan", "format": "{name} | {cores-physical} @ {freq-max}"      },
    { "type": "gpu",      "key": "gpu", "keyColor": "cyan", "format": "{vendor} {name}", "hideType": "integrated"   },
    { "type": "memory",   "key": "ram", "keyColor": "cyan", "format": "{used} / {total}"                            },
    { "type": "disk",     "key": "dsk", "keyColor": "cyan", "format": "{size-used} / {size-total}"                  },
    { "type": "display",  "key": "dsp", "keyColor": "cyan", "format": "{width}x{height} @ {refresh-rate}Hz"         },
    { "type": "wm",       "key": "wm ", "keyColor": "cyan", "format": "{pretty-name}"                               },
    { "type": "custom",   "key": "╰──────────────────────────────────────────────────────────╯", "keyColor": "cyan" }
  ]
}
